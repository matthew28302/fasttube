# ===================================================================
# FastTube Studio - Production Environment Configuration (.env)
# ===================================================================

# Server Networking
RUN_HOST=0.0.0.0
RUN_PORT=9000

# Public URL (Optional: Leave empty for auto-detection behind Nginx / Cloudflare)
# BASE_URL=https://music.yourdomain.com

# Groq API Key for AI Playlist generation (Get free at https://console.groq.com)
GROQ_API_KEY=

# Storage Directories
MUSIC_DIR=music
COOKIES_DIR=cookies

# Concurrency & Performance
MAX_CONCURRENT_DOWNLOADS=3
YTDLP_CONCURRENT_FRAGMENTS=4
MAX_VIDEO_DURATION_S=1200
FAST_MODE=true
PREFER_ABR_128=true
MAX_ABR_KBPS=320

# Security & GeoIP (Chỉ cho phép người dùng từ Việt Nam truy cập)
ALLOW_ONLY_VN=true

# Audio & Video Quality defaults
AUDIO_MODE=auto
AUDIO_BITRATE=128
YTDLP_PLAYER_CLIENT=android,web
YTDLP_VERBOSE=false

# YouTube Innertube / Anti-Bot bypass (Optional)
# PO_TOKEN=
# VISITOR_DATA=
# Proxy configuration (Optional: Bypasses YouTube Datacenter IP blacklist)
# Supports http://, https://, socks5:// (Can also be configured live in Web UI ⚙️)
# YTDLP_PROXY=http://user:pass@host:port

# Telegram Notification (Optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/fasttube.log

ACCESS_PASSWORD=duahau
MAX_FILE_AGE_HOURS=24